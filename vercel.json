{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/api/youtube",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=600, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/api/player-locations",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=21600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/api/coverage",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=120, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/api/channel-stats",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=900, stale-while-revalidate=3600"
        }
      ]
    }
  ]
}
